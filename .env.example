# Opcional. Sin estas variables la aplicación funciona completa (FAQ local en vez de Gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Fecha "hoy" del sistema (los días de atraso se calculan respecto a ella)
FECHA_SISTEMA=2026-10-10
# Ruta de la base SQLite (por defecto data/ponte.db)
# SQLITE_PATH=
# Cupos diarios de respuestas con IA (lo demás se responde con FAQ sin gastar tokens)
GEMINI_MAX_CLIENTE_DIA=15
GEMINI_MAX_DIA=300
