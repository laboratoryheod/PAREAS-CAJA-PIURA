# Copie este archivo a .env.local (que NO se sube a git) y complete lo que necesite.
# Sin claves de IA la aplicación funciona completa: el chatbot responde con filtros y FAQ locales.

# Chatbot de Pareas con OpenAI (tiene prioridad sobre Gemini si ambas están configuradas)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Alternativa: Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cupos diarios de respuestas con IA (lo demás se responde con FAQ sin gastar tokens)
IA_MAX_CLIENTE_DIA=15
IA_MAX_DIA=300

# Fija la fecha del sistema (AAAA-MM-DD). Vacío = fecha real de Perú (lo normal).
# FECHA_SISTEMA=
# Ruta de la base SQLite (por defecto data/ponte.db)
# SQLITE_PATH=

# Secreto para firmar la sesión del gestor (póngale un texto largo y aleatorio en producción)
# SESION_SECRETO=
